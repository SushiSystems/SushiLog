@PACKAGE_INIT@

# What find_package(SushiLog) gives a consumer: SushiLog::SushiLog, the shared library, and
# SushiLog::SushiLogStatic, the static one with hidden symbols. Neither carries this tree's
# warnings or sanitizer.

include(CMakeFindDependencyMacro)
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/SushiLogTargets.cmake")

check_required_components(SushiLog)
